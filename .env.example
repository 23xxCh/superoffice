# MiniMax API Configuration
# Get your API key from https://platform.minimax.chat/
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY

# SenseNova API Configuration
# Get your API key from https://platform.sensenova.cn/
SENSENOVA_API_KEY=YOUR_SENSENOVA_API_KEY

# Optional: Custom API Base URLs
# MINIMAX_API_BASE=https://api.minimax.chat/v1
# SENSENOVA_API_BASE=https://token.sensenova.cn/v1

# Office Automation (Windows only)
# Default working directory for Office files
# OFFICE_ROOT=D:\@SuperOffice

# Debug mode
# DEBUG=false